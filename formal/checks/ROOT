(* The check of the named theorems of the session TRIEL_Core for oracles.
   Built on top of the session TRIEL_Core of formal/core, which is not
   changed:

     isabelle build -e -v -d formal/core -D formal/checks

   -e writes the number of named facts checked in each theory, their sum and
   the excluded facts to output/no_oracles.txt. The build fails if a named
   theorem of a theory of formal/core/ROOT depends on an oracle, except the
   equations of the Quickcheck generators (full_exhaustive, narrowing), which
   Isabelle/HOL generates for a datatype and asserts with the oracle
   Pure.skip_proof instead of proving them; no other named theorem depends on
   them (No_Oracles.thy states the exact rule). *)

session TRIEL_Core_Checks = TRIEL_Core +
  options [document = false]
  theories
    No_Oracles
  export_files (in "output") [1] "*:no_oracles.txt"
