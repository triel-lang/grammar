// temporal.dw for the default event schema, whose windows are at most 24 hours:
// without the owner's window, and with the approval window shortened to 24h.
@id("agent_may_pay")
permit (principal == Inv::Agent::"agent", action == Inv::Action::"Pay", resource);

// MUST_NOT pay WHEN amount > limit AND NOT owner_approved.
@id("over_limit_without_approval")
forbid (principal == Inv::Agent::"agent", action == Inv::Action::"Pay", resource)
when temporal {
    exists (a: Long). (
        formerly within 1h Inv::Action::"Quote"::response{ input.invoice: context.input.invoice, output.amount_cents: a }
        && a > context.input.limit_cents
    )
}
unless temporal {
    formerly within 24h Inv::Action::"Approve"::response{ input.invoice: context.input.invoice }
};

// MAX_AGE 1 HOURS ON_STALE BLOCK: no quote in the last hour -> deny.
@id("block_without_fresh_quote")
forbid (principal == Inv::Agent::"agent", action == Inv::Action::"Pay", resource)
unless temporal {
    formerly within 1h Inv::Action::"Quote"::response{ input.invoice: context.input.invoice }
};
