{
 "repo": "/opt/triel/grammar",
 "evaluator": "/opt/triel/grammar/evaluator/triel-eval",
 "spec": "/etc/triel/mandate.triel",
 "state_dir": "/var/lib/triel/mandate",
 "host_module": "/etc/triel/host.py",
 "host_options": {
  "data_file": "/var/lib/triel/host_data.json",
  "approvals_file": "/var/lib/triel/approvals.jsonl",
  "ledger_file": "/var/lib/triel/approval_ledger.json",
  "executions_file": "/var/lib/triel/executions.json",
  "approval_factors": {"approved": "call_approved", "age": "approval_age",
                       "revoked": "approval_revoked"},
  "payment": {"tool": "mcp__payments__pay", "fields": ["to", "amount", "invoice"],
              "day_total": "day_total", "payee_listed": "payee_listed"}
 },
 "check_timeout_seconds": 35,
 "pending_timeout_seconds": 600,
 "execution_delay_flag_seconds": 5,
 "managed_servers": [
  {"name": "payments", "source": "managed"}
 ],
 "allowed_tools": [
  {"server": "mail", "source": "managed", "tool_name": "mcp__mail__list_messages"},
  {"server": "mail", "source": "managed", "tool_name": "mcp__mail__read_message"}
 ],
 "actions": [
  {"server": "payments", "tool_name": "mcp__payments__pay",
   "subject": "agent", "action": "pay", "atomic": false},
  {"server": "payments", "tool_name": "mcp__payments__convert",
   "subject": "agent", "action": "convert", "atomic": false},
  {"server": "payments", "tool_name": "mcp__payments__raise_limit",
   "subject": "agent", "action": "raise_limit", "atomic": false}
 ]
}
