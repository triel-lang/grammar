(* =========================================================================
   TRIEL v2.4 EBNF Grammar — Normative Specification (PUBLIC / OPEN-SOURCE)
   Core Language Edition
   Author: Dmitri Chistyakov
   © 2026 Dmitri Chistyakov.
   License: Open Web Foundation Agreement 1.0 (OWFa 1.0)
   =========================================================================
*)

(* -------------------------------------------------------------------------
   1. Top-Level Specification
   ------------------------------------------------------------------------- *)

specification      ::= declaration_block
                       subject_block
                       terms_block
                       factors_block
                       [cross_modal_block]
                       invariants_block
                       [modalities_block]

(* -------------------------------------------------------------------------
   2. Declaration Block
   ------------------------------------------------------------------------- *)

declaration_block  ::= "SPECIFICATION" identifier "VERSION" version_literal
                       ["REPLACES" version_literal]
                       ["STANDARD" standard_ref {"," standard_ref}]
                       ["JURISDICTION" jurisdiction_literal]
                       ["IMPORT" import_decl {"," import_decl}]
                       ["PROVENANCE_REQUIRED" ":" boolean_literal]
                       ["ANCHOR_MODE" ":" anchor_mode_val]
                       ["QUORUM_THRESHOLD" ":" integer_literal]
                       ["PROOF_SYSTEM" ":" proof_system_val]
                       ["CURVE" ":" string_literal]
                       ["CURRENCY" ":" string_literal]

proof_system_val   ::= "GROTH16" | "PLONK" | "STARK" | "BULLETPROOFS"

(* NOTE: PROOF_SYSTEM and CURVE are optional in the grammar, but a
   semantic-analysis rule (see SEMANTIC RULES below) requires both
   whenever the specification declares any ZK<T> factor: without them,
   two grammar-conformant compilers can choose different proof systems
   or curves and produce mutually unverifiable proofs from the same
   source, which defeats the deterministic-compilation goal this
   grammar exists to serve. *)

version_literal    ::= integer_literal "." integer_literal ["." integer_literal]
standard_ref       ::= string_literal
jurisdiction_literal ::= string_literal
import_decl        ::= identifier "FROM" string_literal ["AS" identifier]

anchor_mode_val    ::= "NETWORK"
                     | "LOCAL"

(* -------------------------------------------------------------------------
   3. Subject Block
   ------------------------------------------------------------------------- *)

subject_block      ::= "SUBJECTS" "{" subject_decl {"," subject_decl} "}"
subject_decl       ::= identifier ":" role_type ["DID" did_literal]
role_type          ::= "PARTY" | "ORACLE" | "REGULATOR" | "SYSTEM"
did_literal        ::= string_literal

(* -------------------------------------------------------------------------
   4. Terms Block
   ------------------------------------------------------------------------- *)

term_element       ::= named_term_decl | term_stmt
terms_block        ::= "TERMS" "{" term_element {";" term_element} "}"

named_term_decl    ::= identifier ":=" term_stmt

term_stmt          ::= choice_expr

choice_expr        ::= parallel_expr ("OR" parallel_expr)*
parallel_expr      ::= sequence_expr ("AND" sequence_expr)*
sequence_expr      ::= unless_expr ("THEN" unless_expr)*
unless_expr        ::= timeout_expr ("UNLESS" expr "DO" timeout_expr)?
timeout_expr       ::= base_term ("WITHIN" deadline_expr ["ELSE" base_term])?

(* --- Disambiguation fix (see PATCH log): base_term now routes through
   matched_term / unmatched_term instead of condition_stmt directly, so
   that ELSE-binding in nested IF chains is deterministic. --- *)

base_term           ::= matched_term | unmatched_term

matched_term        ::= matched_condition
                      | obligation_stmt
                      | permission_stmt
                      | prohibition_stmt
                      | trigger_stmt
                      | breach_handler_stmt
                      | contract_ref_stmt
                      | "(" term_stmt ")"

unmatched_term       ::= unmatched_condition

condition_stmt       ::= matched_condition | unmatched_condition

(* Every branch of a matched_condition is itself fully resolved — any
   nested IF inside it must also have an ELSE. This is what makes ELSE
   binding unambiguous: an ELSE can only ever attach to the nearest
   still-open (unmatched) IF. *)
matched_condition    ::= "IF" expr "THEN" matched_term
                         {"ELIF" expr "THEN" matched_term}
                         "ELSE" matched_term
                       | "WHEN" expr "THEN" matched_term

(* An unmatched_condition is an IF/ELIF chain with no ELSE yet at the
   outermost level — or one whose last ELSE/ELIF branch is itself still
   unmatched. This is the only place a "dangling" IF can occur, and it
   can only ever occur once per chain. *)
unmatched_condition  ::= "IF" expr "THEN" term_stmt
                       | "IF" expr "THEN" matched_term
                         {"ELIF" expr "THEN" matched_term}
                         "ELIF" expr "THEN" unmatched_term
                       | "IF" expr "THEN" matched_term
                         {"ELIF" expr "THEN" matched_term}
                         "ELSE" unmatched_term

obligation_stmt    ::= identifier "MUST" action_expr
                       ["BY" deadline_expr]
                       ["FROM" datetime_expr]
                       ["UNTIL" datetime_expr]

permission_stmt    ::= identifier "MAY" action_expr
                       ["WHEN" expr]
                       ["WITHIN" deadline_expr]

prohibition_stmt   ::= identifier "MUST_NOT" action_expr
                       ["WHEN" expr]

trigger_stmt       ::= "ON" event_expr "DO" term_stmt

breach_handler_stmt ::= identifier "ON_BREACH"
                        breach_action {"," breach_action}

breach_action      ::= "PENALTY" expr ["CAP" literal]
                     | "NOTIFY" identifier
                     | "TERMINATE"
                     | "CURE_BY" deadline_expr
                     | "ESCALATE_TO" identifier

(* NOTE ON PENALTY (C-16): expr still evaluates to a bare number — there
   is no dedicated monetary type in v2.4, and fixing that fully (exact
   decimal arithmetic, currency-typed values) is future work. Two things
   ARE fixed here: (1) CAP literal sets a hard upper bound on the
   computed amount, closing the "no upper bound" half of C-16; (2) a
   semantic-analysis rule (see SEMANTIC RULES below) requires CURRENCY
   to be declared (§2) whenever any breach_action in the specification
   is a PENALTY, and requires the computed amount to be non-negative.
   See TECHNICAL_REPORT.md §2.9. *)

contract_ref_stmt  ::= "EXECUTE" identifier
                       ["WITH" "{" binding {"," binding} "}"]

binding            ::= identifier ":=" expr

(* -------------------------------------------------------------------------
   5. Factors Block
   ------------------------------------------------------------------------- *)

factors_block      ::= "FACTORS" "{" factor_decl {"," factor_decl} "}"

factor_decl        ::= identifier ":" type_expr
                       ("POLARITY" polarity_val | "METADATA")
                       ["THRESHOLD" numeric_literal]
                       ["SOURCE" factor_source]
                       ["MAX_AGE" duration_literal]
                       ["ON_STALE" stale_action]
                       ["CAUSED_BY" "{" caused_by_entry {"," caused_by_entry} "}"]
                       ["SENSITIVITY_BOUND" numeric_literal]

stale_action       ::= "BLOCK"
                     | "USE_LAST"
                     | "ESCALATE_TO" identifier

(* NOTE ON ORACLE TRUST (C-15): a factor's MAX_AGE says how old data is
   allowed to get before it counts as stale, but v2.4 published no
   grammar for what happens AT that point — this closes that gap.
   BLOCK halts evaluation of anything depending on the factor until
   fresh data arrives; USE_LAST keeps the last known value but flags it
   stale to the compiler's audit trail; ESCALATE_TO hands the staleness
   event to another subject, the same pattern breach_action already
   uses (§4). A semantic-analysis rule (see SEMANTIC RULES below)
   requires ON_STALE whenever MAX_AGE is present — a factor that can go
   stale with no declared behavior for that case is a compile error,
   not a silent gap. Source-signing and multi-source quorum for oracle
   data remain open; see TECHNICAL_REPORT.md §2.9. *)

polarity_val       ::= float_literal

factor_source      ::= identifier

(* -------------------------------------------------------------------------
   6. Type Expressions
   ------------------------------------------------------------------------- *)

type_expr          ::= type_base {"CONSTRAINT" "(" expr ")"}

type_base          ::= primitive_type
                     | zk_type
                     | enum_ref
                     | composite_type
                     | "Optional" "<" type_expr ">"

primitive_type     ::= "Float" | "Decimal" | "Integer" | "Boolean"
                     | "String" | "DateTime" | "Duration"
                     | "Address" | "Hash"

composite_type     ::= "Record" "{" field_decl {"," field_decl} "}"
                     | "List"   "<" type_expr ">"
                     | "Map"    "<" type_expr "," type_expr ">"
                     | "Progress" "<" enum_ref ">"

field_decl         ::= identifier ":" type_expr ["DEFAULT" literal]

enum_ref           ::= identifier

zk_type            ::= "ZK" "<" zk_primitive_type ">" zk_constraints

(* NOTE: zk_type is restricted to a finite/hashable subset of primitive_type
   (Integer, Boolean, String, Address, Hash) and excludes Float and Decimal.
   Proof systems operate over finite fields; representing floating-point
   values in them is a known soundness and cost hazard (comparisons can
   lose meaning, and proof size grows sharply). A specification needing to
   prove something about a decimal quantity should scale it to an Integer
   at the specification boundary instead. *)
zk_primitive_type  ::= "Integer" | "Boolean" | "String" | "Address" | "Hash"

zk_constraints     ::= "PROVES" "(" zk_constraint {"," zk_constraint} ")"
                       ["WITHOUT" "REVEALING" zk_visibility]
                       ["PUBLIC_WITNESS" "(" identifier {"," identifier} ")"]
                       ["BOUND_TO" "(" identifier "," identifier ")"]

zk_constraint      ::= "self" comparison_op literal
                     | "self" "IN" "RANGE" "[" literal "," literal "]"
                     | "self" "IN" "SET"   "{" literal {"," literal} "}"
                     | "HASH" "(" "self" "," salt_ref ")" comparison_op literal

salt_ref           ::= identifier

(* NOTE ON HASH SALTING (B-10): a HASH(self) constraint over a
   low-entropy field (age, category, a small enumerated range) is
   brute-forceable by hashing every candidate value and comparing —
   there is no way to add a salt after the fact, so the grammar
   requires one syntactically. salt_ref MUST name a factor whose value
   is unique per specification instance and never reused across
   instances; a compiler MUST reject a HASH constraint whose salt_ref
   points to a METADATA factor with a fixed, specification-wide
   literal default, since that is not a salt, just a constant. *)

zk_visibility      ::= "self" | "ALL"

(* NOTE: the ["WITHOUT" "REVEALING" zk_visibility] clause is optional in the
   grammar, but its absence is not "unspecified" at the semantic level: a
   zk_type factor with no WITHOUT REVEALING clause at all defaults to
   zk_visibility = "self" (fully hidden). Privacy is the secure default;
   writing WITHOUT REVEALING ALL is required to opt OUT of it, and the
   grammar makes that opt-out visible in the source rather than implicit.
   See TECHNICAL_REPORT.md §2.7 for the enforcement rule this supports. *)

(* NOTE ON BOUND_TO (B-11): a ZK proof with no binding to who presented
   it or when can be replayed verbatim by anyone who observes it once.
   ["BOUND_TO" "(" identifier "," identifier ")"] takes two references:
   the first MUST be a subject_decl carrying a DID (§3); the second
   MUST be a factor holding a single-use session nonce, refreshed per
   presentation. A semantic-analysis rule (see SEMANTIC RULES below)
   requires this clause whenever the proving subject has a declared
   DID — a proof about a DID-bearing identity with no BOUND_TO clause
   is a compile error, not a silently accepted specification. See
   TECHNICAL_REPORT.md §2.8 for the full rule. *)

(* -------------------------------------------------------------------------
   7. Cross-Modal Block
   ------------------------------------------------------------------------- *)

cross_modal_block  ::= "CROSS_MODAL"
                       "{" cross_modal_decl {"," cross_modal_decl} "}"

cross_modal_decl   ::= identifier ":"
                       "{" factor_ref "IN" modality_id ","
                           factor_ref "IN" modality_id "}"
                       ["TOLERANCE" numeric_literal]
                       ["SEVERITY" ("CRITICAL" | "WARNING")]

modality_id        ::= identifier

(* NOTE: modality_id accepts any identifier. Concrete modality names
   are defined by the compiler implementation, not by this grammar.
   A reference to an undeclared modality is a semantic analysis error. *)

(* -------------------------------------------------------------------------
   8. Invariants Block
   ------------------------------------------------------------------------- *)

invariants_block   ::= "INVARIANTS" "{" invariant_decl {";" invariant_decl} "}"

invariant_decl     ::= identifier [":" invariant_type] ":" temporal_expr

invariant_type     ::= "SAFETY" | "LIVENESS" | "FAIRNESS"

temporal_expr      ::= causal_expr
                     | ltl_expr
                     | ctl_expr
                     | state_invariant
                     | cross_modal_invariant

causal_expr        ::= "FORALL" identifier "IN" event_class ":"
                       "EXISTS" identifier "IN" event_class ":"
                       identifier "HAPPENS_BEFORE" identifier

ltl_expr           ::= ltl_implication
ltl_implication    ::= ltl_until ("->" ltl_until)*
ltl_until          ::= ltl_or (("U" | "R" | "W") ltl_or)*
ltl_or             ::= ltl_and ("||" ltl_and)*
ltl_and            ::= ltl_unary ("&&" ltl_unary)*
ltl_unary          ::= "!" ltl_unary
                     | "G" ltl_unary
                     | "F" ltl_unary
                     | "X" ltl_unary
                     | ltl_atom
ltl_atom           ::= state_expr | "(" ltl_expr ")"

ctl_expr           ::= ctl_or
ctl_or             ::= ctl_and ("||" ctl_and)*
ctl_and            ::= ctl_path_formula ("&&" ctl_path_formula)*
ctl_path_formula   ::= ("A" | "E") ctl_temporal_op "(" ctl_expr ")"
                     | ctl_atom
ctl_temporal_op    ::= "X" | "F" | "G" | "U" | "R"
ctl_atom           ::= state_expr | "(" ctl_expr ")"

state_invariant    ::= "ALWAYS"     "(" expr ")"
                     | "EVENTUALLY" "(" expr ")" ["WITHIN" deadline_expr]
                     | "NEXT"       "(" expr ")"
                     | "DAG"        "(" identifier ")"

cross_modal_invariant ::= "CROSS_MODAL_CONSISTENT"
                          "(" identifier {"," identifier} ")"

event_class        ::= identifier ["(" param_decl {"," param_decl} ")"]
param_decl         ::= identifier ":" type_expr

(* -------------------------------------------------------------------------
   9. Modalities Block
   ------------------------------------------------------------------------- *)

modalities_block   ::= "MODALITIES" "{" modality_conf {"," modality_conf} "}"

modality_conf      ::= modality_id ":" "{" modality_param {"," modality_param} "}"

modality_param     ::= identifier ":" literal

(* -------------------------------------------------------------------------
   10. Expressions
   ------------------------------------------------------------------------- *)

expr               ::= implication_expr

implication_expr   ::= disjunction_expr ("IMPLIES" disjunction_expr)*
disjunction_expr   ::= conjunction_expr ("OR" conjunction_expr)*
conjunction_expr   ::= negation_expr ("AND" negation_expr)*
negation_expr      ::= "NOT" negation_expr | comparison_expr
comparison_expr    ::= arithmetic_expr (comparison_op arithmetic_expr)?
arithmetic_expr    ::= mul_expr (("+" | "-") mul_expr)*
mul_expr           ::= unary_expr (("*" | "/" | "%") unary_expr)*
unary_expr         ::= "-" unary_expr | primary

primary            ::= literal
                     | factor_ref
                     | function_call
                     | "(" expr ")"
                     | if_expr
                     | let_expr
                     | presence_expr
                     | default_expr

presence_expr      ::= "PRESENT" "(" factor_ref ")"
default_expr       ::= "DEFAULT" "(" factor_ref "," expr ")"

(* NOTE ON MISSING VALUES (D-29): Optional<T> (§6) had no operators —
   nothing in v2.4 could ask whether an Optional factor holds a value,
   or supply a fallback when it doesn't, so an invariant reading one
   was undefined the moment the factor was empty. PRESENT(f) evaluates
   to a Boolean: true if factor f currently holds a value, false if it
   is an empty Optional<T> OR has gone stale under its ON_STALE rule
   (§5) — staleness is treated as absence for this purpose, since a
   value the specification no longer trusts is not meaningfully
   "there." DEFAULT(f, fallback) evaluates to f's value when present
   and to fallback otherwise, so an invariant can be written total
   over both cases without a separate IF/THEN guard every time. *)

if_expr            ::= "IF" expr "THEN" expr
                       {"ELIF" expr "THEN" expr}
                       "ELSE" expr

let_expr           ::= "LET" identifier ":" type_expr "=" expr "IN" expr

function_call      ::= identifier "(" [expr {"," expr}] ")"

comparison_op      ::= "<" | "<=" | ">" | ">=" | "==" | "!="

action_expr        ::= identifier ["(" [expr {"," expr}] ")"]

event_expr         ::= identifier ["(" [expr {"," expr}] ")"]

factor_ref         ::= identifier ("." identifier)*

deadline_expr      ::= datetime_literal
                     | duration_literal
                     | datetime_expr "+" duration_literal
                     | datetime_expr "-" duration_literal
                     | factor_ref

datetime_expr      ::= datetime_literal | factor_ref
state_expr         ::= expr

(* -------------------------------------------------------------------------
   11. Literals and Identifiers
   ------------------------------------------------------------------------- *)

literal            ::= numeric_literal
                     | string_literal
                     | boolean_literal
                     | datetime_literal
                     | duration_literal

numeric_literal    ::= integer_literal | float_literal
integer_literal    ::= digit+
float_literal      ::= digit+ "." digit+ [("e" | "E") ["+" | "-"] digit+]
boolean_literal    ::= "true" | "false"
string_literal     ::= '"' {character} '"'
datetime_literal   ::= "DATETIME" "(" string_literal ")"
duration_literal   ::= integer_literal time_unit

time_unit          ::= "SECOND" | "SECONDS" | "MINUTE" | "MINUTES"
                     | "HOUR" | "HOURS" | "DAY" | "DAYS"
                     | "BUSINESS_DAY" | "BUSINESS_DAYS"
                     | "MONTH" | "MONTHS" | "YEAR" | "YEARS"

identifier         ::= letter (letter | digit | "_")*
                       (* constraint: MUST NOT be lexically identical to
                          any reserved keyword listed in §11a below. A
                          conforming lexer MUST reject, at tokenization
                          time, any identifier-shaped token that exactly
                          matches a reserved keyword; it MUST NOT
                          silently prefer one interpretation over the
                          other. *)

(* -------------------------------------------------------------------------
   11a. Reserved Keywords
   ------------------------------------------------------------------------- *)

(* The following 139 tokens are reserved by this grammar and MUST NOT be
   used as an identifier, in any position where identifier is a valid
   production, in any conforming TRIEL specification: *)

   "A", "Address", "ALL", "ALWAYS", "ANCHOR_MODE", "AND", "AS", "BLOCK",
   "Boolean", "BOUND_TO", "BULLETPROOFS", "BUSINESS_DAY", "BUSINESS_DAYS", "BY", "CAP", "CAUSED_BY",
   "CONSTRAINT", "CRITICAL", "CROSS_MODAL", "CROSS_MODAL_CONSISTENT", "CURE_BY", "CURRENCY", "CURVE", "DAG",
   "DATETIME", "DateTime", "DAY", "DAYS", "Decimal", "DEFAULT", "DID", "DO",
   "Duration", "E", "ELIF", "ELSE", "ESCALATE_TO", "EVENTUALLY", "EXECUTE", "EXISTS",
   "F", "FACTORS", "FAIRNESS", "false", "Float", "FORALL", "FROM", "G",
   "GROTH16", "HAPPENS_BEFORE", "HASH", "Hash", "HOUR", "HOURS", "IF", "IMPLIES",
   "IMPORT", "IN", "Integer", "INVARIANTS", "JURISDICTION", "LET", "List", "LIVENESS",
   "LOCAL", "Map", "MAX_AGE", "MAY", "METADATA", "MINUTE", "MINUTES", "MODALITIES",
   "MONTH", "MONTHS", "MUST", "MUST_NOT", "NETWORK", "NEXT", "NOT", "NOTIFY",
   "ON", "ON_BREACH", "ON_STALE", "Optional", "OR", "ORACLE", "PARTY", "PENALTY",
   "PLONK", "POLARITY", "PRESENT", "Progress", "PROOF_SYSTEM", "PROVENANCE_REQUIRED", "PROVES", "PUBLIC_WITNESS",
   "QUORUM_THRESHOLD", "R", "RANGE", "Record", "REGULATOR", "REPLACES", "REVEALING", "SAFETY",
   "SECOND", "SECONDS", "self", "SENSITIVITY_BOUND", "SET", "SEVERITY", "SOURCE", "SPECIFICATION",
   "STANDARD", "STARK", "String", "SUBJECTS", "SYSTEM", "TERMINATE", "TERMS", "THEN",
   "THRESHOLD", "TOLERANCE", "true", "U", "UNLESS", "UNTIL", "USE_LAST", "VERSION",
   "W", "WARNING", "WEIGHT", "WHEN", "WITH", "WITHIN", "WITHOUT", "X",
   "YEAR", "YEARS", "ZK"

(* IMPLEMENTATION NOTE — single-letter LTL/CTL operators: eight of the
   reserved tokens above ("A", "E", "F", "G", "R", "U", "W", "X") are
   single uppercase letters, used as LTL/CTL temporal operators in
   Section 8 (ltl_unary, ltl_until, ctl_path_formula, ctl_temporal_op).
   Reserving them is necessary for correctness, but it means no bare
   single uppercase letter may be used as an identifier anywhere in a
   TRIEL specification. This is a known, deliberate trade-off. If this
   proves too restrictive in practice, the alternative is to require
   the fully-spelled forms already available for state_invariant
   (ALWAYS/EVENTUALLY/NEXT) and retire the bare single-letter LTL/CTL
   operator forms in a future version — that would be a breaking
   syntax change and remains an open design question. *)

(* -------------------------------------------------------------------------
   11b. Shared Rules
   ------------------------------------------------------------------------- *)

caused_by_entry    ::= identifier "WEIGHT" numeric_literal
                       (* WEIGHT ∈ [-1.0, 1.0]; ≠ 0.0 *)

(* -------------------------------------------------------------------------
   12. Lexical Tokens
   ------------------------------------------------------------------------- *)

letter             ::= "A".."Z" | "a".."z"
digit              ::= "0".."9"
character          ::= ? any-ASCII-character-except-double-quote ?

(* Comments:
   Single-line : -- comment to end of line
   Multi-line  : {- comment -}                                               *)

(* =========================================================================
   SEMANTIC RULES
   =========================================================================

   PROVENANCE / ANCHOR / QUORUM — RESERVED EXTENSION FIELDS

   The fields PROVENANCE_REQUIRED, ANCHOR_MODE and QUORUM_THRESHOLD are
   declared in declaration_block (see §2) as syntactic extension points
   for specification provenance verification.

   The semantics of these fields are defined by the compiler
   implementation and are not part of the normative TRIEL grammar.
   The grammar guarantees only syntactic correctness and value types
   of these fields:

     PROVENANCE_REQUIRED ::= boolean_literal       (default: false)
     ANCHOR_MODE          ::= "NETWORK" | "LOCAL"   (default: NETWORK)
     QUORUM_THRESHOLD     ::= integer_literal       (default: 5)
                               constraint: 1 ≤ QUORUM_THRESHOLD ≤ n,
                               where n = number of active modalities
                               declared in the MODALITIES block.
                               Constraint violation = compile error
                               at semantic analysis phase.

   If PROVENANCE_REQUIRED is true, the compiler requires provenance
   verification data before generating modality output; the concrete
   verification mechanism is implemented at compiler level and is not
   specified by this grammar.

   =========================================================================

   ZK CRYPTOGRAPHIC PARAMETERIZATION AND BINDING (v2.4, B-10/B-11/B-12)

   PROOF_SYSTEM and CURVE (declaration_block, §2) are optional in the
   grammar but REQUIRED at semantic analysis whenever a specification's
   FACTORS block declares any zk_type factor. A specification with a
   ZK<T> factor and no PROOF_SYSTEM/CURVE pair is a compile error: two
   conformant compilers must not be free to pick different proof
   systems for the same source. There is no default — omission is an
   error, not a fallback to an implicit choice, since an implicit
   choice is exactly what breaks cross-compiler determinism.

   BOUND_TO (zk_constraints, §6) is optional in the grammar but
   REQUIRED at semantic analysis whenever the subject named in the
   enclosing FACTORS's SOURCE clause has a DID declared in SUBJECTS
   (§3). A ZK factor sourced from a DID-bearing subject with no
   BOUND_TO clause is a compile error: without it, a proof captured
   once can be replayed by anyone who observed it, for any subject,
   at any later time — the DID declaration implies the specification
   cares who is presenting, and BOUND_TO is what makes that care
   enforceable rather than aspirational.

   Salting (zk_constraint's HASH form, §6) is enforced directly by the
   grammar rather than by a semantic rule, since a HASH constraint
   syntactically requires a salt_ref and cannot be written without one.

   =========================================================================

   ORACLE TRUST, MONETARY VALUES, AND MISSING DATA (v2.4, C-15/C-16/D-29)

   ON_STALE (factor_decl, §5) is optional in the grammar but REQUIRED
   at semantic analysis whenever the same factor declares MAX_AGE: a
   factor that can go stale with no declared fallback behavior is a
   compile error, not an implicit "treat the old value as still good."

   PROVENANCE_REQUIRED (declaration_block, §2) is optional in the
   grammar but REQUIRED (and must be true) at semantic analysis
   whenever any factor's SOURCE clause names a subject declared
   ORACLE in SUBJECTS (§3). This connects two fields the v2.4 grammar
   already had — PROVENANCE_REQUIRED existed, ORACLE existed — but
   never formally required together; the concrete signature/attestation
   mechanism satisfying PROVENANCE_REQUIRED remains compiler-defined,
   consistent with how that field's semantics were already scoped
   above. Multi-source quorum for oracle data and a dispute mechanism
   for a contested value are not addressed by this rule and remain
   open.

   CURRENCY (declaration_block, §2) is optional in the grammar but
   REQUIRED at semantic analysis whenever any breach_action in the
   specification is a PENALTY: an amount with no declared currency is
   not a monetary value, just a number. The amount a PENALTY expr
   computes at breach time MUST be non-negative; CAP (breach_action,
   §4) sets its upper bound where the specification author chooses to
   declare one. A literal used in a Decimal- or Money-denominated
   context MUST be interpreted as an exact base-10 decimal, not an
   IEEE-754 binary float, despite float_literal (§11) being the shared
   lexical form for both — this grammar has no separate exact-decimal
   literal syntax yet, so the distinction is enforced at the semantic
   level, not the lexical one. A first-class monetary type (units,
   rounding rules, overflow behavior) remains future work.

   PRESENT(f) and DEFAULT(f, fallback) (primary, §10) are ordinary
   grammar productions, not semantic-rule-gated like the fields above:
   they are simply new expression forms usable wherever expr is valid.
   No additional semantic rule makes them mandatory, since not every
   Optional<T> factor needs a fallback to be well-formed — omitting
   them is only a problem if the specification's INVARIANTS block goes
   on to read that factor's value directly without one, which is a
   type-checking concern for the same future analysis pass already
   noted for the information-flow rule of TECHNICAL_REPORT.md §2.7.

   =========================================================================

   NOTE ON WITHIN duration semantics (v2.4):

   When deadline_expr in EVENTUALLY(...) WITHIN ... resolves to a
   duration_literal (not an absolute datetime), the timer origin is
   fixed at specification activation time — not at invariant evaluation
   time. This is commitment semantics: the deadline is set once and
   does not reset on re-evaluation. A reactive/re-evaluation-relative
   timer is NOT supported by WITHIN and would require a distinct,
   explicit construct if ever needed.

   =========================================================================

   NOTE ON Progress<T> completion semantics (v2.4):

   Progress<T> desugars to:
     Record { status: T, completion: Float CONSTRAINT(self >= 0.0 AND self <= 1.0) }

   If T resolves to the canonical status enum (NOT_STARTED, IN_PROGRESS,
   STABLE), the compiler's validation pass enforces:
     STABLE      -> completion == 1.0
     NOT_STARTED -> completion == 0.0
     IN_PROGRESS -> completion IN [0.0, 1.0)

   For any other (user-defined) enum_ref, completion remains free in
   [0.0, 1.0] with no semantic binding to the status value. This
   constraint is NOT part of the grammar — it is enforced at semantic
   analysis, consistent with how PROVENANCE_REQUIRED/ANCHOR_MODE/
   QUORUM_THRESHOLD semantics are handled above.

   =========================================================================

   USAGE EXAMPLES

   Example 1: Specification requiring provenance verification
   -----------------------------------------------------------
   SPECIFICATION patient_consent VERSION 1.0.0
       STANDARD "HL7-FHIR-R4", "GDPR-Art-7"
       JURISDICTION "EU"
       PROVENANCE_REQUIRED: true
       ANCHOR_MODE: NETWORK
       QUORUM_THRESHOLD: 5

   Example 2: Offline mode
   -----------------------------------------------------------
   SPECIFICATION probe_patch VERSION 1.0.0
       JURISDICTION "DEEP_SPACE"
       PROVENANCE_REQUIRED: true
       ANCHOR_MODE: LOCAL
       QUORUM_THRESHOLD: 5

   Example 3: Backward compatibility
   -----------------------------------------------------------
   SPECIFICATION legacy_contract VERSION 1.0.0
       STANDARD "EU-MiFID-II"
   -- Fields PROVENANCE_REQUIRED, ANCHOR_MODE, QUORUM_THRESHOLD
   -- absent → defaults: false, NETWORK, 5.

   Example 4: Elevated threshold
   -----------------------------------------------------------
   SPECIFICATION satellite_fw VERSION 2.0.0
       JURISDICTION "AEROSPACE"
       PROVENANCE_REQUIRED: true
       ANCHOR_MODE: LOCAL
       QUORUM_THRESHOLD: 7

   Example 5: Cross-modal reference using abstract modality names
   -----------------------------------------------------------
   CROSS_MODAL {
     payment_vs_legal: {
       payment.amount IN modality_a,
       contract.clause IN modality_b
     } TOLERANCE 0.01 SEVERITY CRITICAL
   }
   -- Modality names are placeholders here and are resolved by the
   -- compiler. The grammar accepts any identifier in this position.

   Example 6: REPLACES for version chaining (v2.4)
   -----------------------------------------------------------
   SPECIFICATION project_task_distribution VERSION 2.0.0
       REPLACES 1.0.0
       JURISDICTION "INTERNAL"

   Example 7: EVENTUALLY with WITHIN deadline (v2.4)
   -----------------------------------------------------------
   INVARIANTS {
     delivery_committed : LIVENESS : EVENTUALLY(status == STABLE) WITHIN 30 DAYS
   }

   Example 8: Progress<T> factor (v2.4)
   -----------------------------------------------------------
   FACTORS {
     parser_progress : Progress<BuildStatus> METADATA SOURCE build_system
   }

   =========================================================================

   NOTE ON LTL/CTL MIXING:
   temporal_expr allows ltl_expr and ctl_expr within the same
   invariants_block. Each formula is validated according to its own
   logic, independently of the other. Mixing is permitted.

   =========================================================================
*)
