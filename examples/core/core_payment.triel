-- TRIEL example inside the formal core: actions with arguments, an obligation
-- whose window opens with FROM, and penalties computed at the moment of
-- breach, with CAP. An event matches a norm only with the same arguments; a
-- payment before FROM does not count; the penalty is read in the state in
-- which the breach occurs. Every construct in this file is translated into
-- the Isabelle/HOL core (formal/core) and evaluated by the exported evaluator
-- (evaluator/).

SPECIFICATION core_payment VERSION 1.0.0
    CURRENCY: "EUR"

SUBJECTS {
  tenant   : PARTY,
  landlord : PARTY,
  bank     : PARTY
}

TERMS {
  tenant MUST pay(landlord, 1200) BY 10 DAYS FROM DATETIME("2026-03-01T00:00:00Z");
  tenant ON_BREACH
    PENALTY DEFAULT(arrears, 0) * 0.1 + 50 CAP 200,
    NOTIFY landlord,
    CURE_BY 5 DAYS;
  landlord MUST_NOT enter(tenant) WHEN NOT notice_given;
  landlord ON_BREACH PENALTY rent * 2 CAP 1000, NOTIFY tenant;
  tenant MAY sublet("room") WHEN rent >= 1000
}

FACTORS {
  arrears      : Optional<Decimal> METADATA SOURCE bank,
  rent         : Decimal METADATA,
  notice_given : Boolean METADATA
}

INVARIANTS {
  rent_positive : SAFETY : ALWAYS(rent > 0)
}
