-- TRIEL example inside the formal core: a stale factor under ON_STALE BLOCK,
-- a prohibition whose condition becomes undefined, and an escalation.
-- Every construct in this file is translated into the Isabelle/HOL core
-- (formal/core) and evaluated by the exported evaluator (evaluator/).

SPECIFICATION core_stale_block VERSION 1.0.0
    JURISDICTION "EU"

SUBJECTS {
  insurer  : PARTY,
  oracle_a : ORACLE,
  auditor  : REGULATOR
}

TERMS {
  insurer MUST review_claim WITHIN 2 DAYS;
  insurer ON_BREACH ESCALATE_TO auditor;
  insurer MUST_NOT pay_claim WHEN sanctioned OR NOT PRESENT(claim.amount)
}

FACTORS {
  sanctioned : Boolean METADATA SOURCE oracle_a MAX_AGE 1 DAYS ON_STALE BLOCK,
  claim      : Record { amount : Integer } METADATA SOURCE oracle_a
}

INVARIANTS {
  not_sanctioned : SAFETY : ALWAYS(sanctioned == false)
}
