; A fresh sanction flag is true when the claim is paid.
(scenario stale_block_fresh_breach
  (spec "examples/core/core_stale_block.triel")
  (entry "2026-03-01T00:00:00Z" (activate)
    (data (claim (record (amount (int 100))))))
  (entry "2026-03-01T01:00:00Z" (arrive sanctioned)
    (data (sanctioned (bool true)) (claim (record (amount (int 100))))))
  (entry "2026-03-01T02:00:00Z" (act insurer pay_claim must_not)
    (data (sanctioned (bool true)) (claim (record (amount (int 100)))))))
