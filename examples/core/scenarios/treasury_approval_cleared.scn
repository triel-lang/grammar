; Two requests of 1500000 euros. The company approves the request r1, which
; goes out at 09:00:30. From the next entry on the host no longer reports that
; approval; it reports the new balance of 2700000 and the day's total of
; 3000000 for the next request, r2, and a new quote arrives. For r2 no
; approval is reported, so the condition of the approval rule is undefined:
; MONITOR 10 alone blocks r2, TERM 10 stays PENDING, and a host holds r2 and
; routes it to the company.
(scenario treasury_approval_cleared
  (spec "examples/core/treasury_mandate.triel")
  (entry "2026-11-20T09:00:00Z" (activate)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00))))
  (entry "2026-11-20T09:00:10Z" (arrive eur_balance)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00))))
  (entry "2026-11-20T09:00:20Z" (arrive quote_rate)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450))))
  (entry "2026-11-20T09:00:30Z" (tick)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450)) (request_id (str "r1")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 1500000.00)) (day_total_eur (dec 1500000.00)) (approved_request (str "r1"))))
  (entry "2026-11-20T09:00:30Z" (act agent request_conversion must_not)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450)) (request_id (str "r1")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 1500000.00)) (day_total_eur (dec 1500000.00)) (approved_request (str "r1"))))
  (entry "2026-11-20T09:00:50Z" (arrive eur_balance)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 2700000.00)) (quote_rate (dec 1.1450)) (request_id (str "r2")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 1500000.00)) (day_total_eur (dec 3000000.00))))
  (entry "2026-11-20T09:01:00Z" (arrive quote_rate)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 2700000.00)) (quote_rate (dec 1.1452)) (request_id (str "r2")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 1500000.00)) (day_total_eur (dec 3000000.00))))
  (entry "2026-11-20T09:01:00Z" (act agent request_conversion must_not)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (day_limit (dec 10000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 2700000.00)) (quote_rate (dec 1.1452)) (request_id (str "r2")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 1500000.00)) (day_total_eur (dec 3000000.00)))))
