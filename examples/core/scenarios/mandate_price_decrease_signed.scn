; A price decrease of 35 percent that the host reports with a sign, as -35.0,
; without approval. The rule reads the number it is given, and -35.0 is not
; more than 20, so the monitor allows the change and nothing is breached. The
; host must report the size of a change as a non-negative percentage; a
; decrease of 35 percent reported as 35.0 is mandate_price_over_limit.
(scenario mandate_price_decrease_signed
  (spec "examples/core/merchant_mandate.triel")
  (entry "2026-11-10T09:00:00Z" (activate)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10))))
  (entry "2026-11-10T09:10:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec -35.0)) (price_change_approved (bool false))))
  (entry "2026-11-10T09:10:01Z" (act agent apply_price_change must_not)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec -35.0)) (price_change_approved (bool false)))))
