; A fresh stock level of 10, exactly at the reorder point, and a restock
; without approval: 10 is not above 10, so the condition is false and the
; monitor allows the restock.
(scenario mandate_restock_at_reorder_point
  (spec "examples/core/merchant_mandate.triel")
  (entry "2026-11-10T09:00:00Z" (activate)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10))))
  (entry "2026-11-10T10:00:00Z" (arrive stock_units)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 10))))
  (entry "2026-11-10T10:20:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 10)) (restock_approved (bool false))))
  (entry "2026-11-10T10:20:01Z" (act agent apply_restock must_not)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 10)) (restock_approved (bool false)))))
