; The invoice is quoted at 1500.00 EUR, over the limit of 1000.00, and the
; owner has approved the payment. The agent pays while the quote is fresh:
; the condition is false, so the prohibition is not breached, and the payment
; discharges the obligation.
(scenario invoice_approved
  (spec "examples/core/core_invoice_agent.triel")
  (entry "2026-11-02T09:00:00Z" (activate) (data (limit_eur (dec 1000.00)) (owner_approved (bool false))))
  (entry "2026-11-02T09:30:00Z" (arrive amount_eur)
    (data (amount_eur (dec 1500.00)) (limit_eur (dec 1000.00)) (owner_approved (bool true))))
  (entry "2026-11-02T10:00:00Z" (act agent (pay (name supplier)) must)
    (data (amount_eur (dec 1500.00)) (limit_eur (dec 1000.00)) (owner_approved (bool true)))))
