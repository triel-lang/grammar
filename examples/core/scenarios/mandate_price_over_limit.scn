; A price change of 35 percent without the owner's approval is applied: the
; condition is true, so the price rule is breached at the change, the owner is
; notified, and the monitor blocks it.
(scenario mandate_price_over_limit
  (spec "examples/core/merchant_mandate.triel")
  (entry "2026-11-10T09:00:00Z" (activate)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10))))
  (entry "2026-11-10T09:10:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec 35.0)) (change_approved (bool false))))
  (entry "2026-11-10T09:10:01Z" (act agent apply_price_change must_not)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec 35.0)) (change_approved (bool false)))))
