; A stock level of 4 arrives at 10:00:00 and is exactly one hour old at
; 11:00:00, MAX_AGE included, so it is fresh there. The restock is applied at
; 11:00:01, when the level is older than an hour; the condition is read in the
; state of 11:00:00, where it is false, so the monitor allows the restock.
(scenario mandate_restock_max_age
  (spec "examples/core/merchant_mandate.triel")
  (entry "2026-11-10T09:00:00Z" (activate)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10))))
  (entry "2026-11-10T10:00:00Z" (arrive stock_units)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 4))))
  (entry "2026-11-10T11:00:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 4)) (restock_approved (bool false))))
  (entry "2026-11-10T11:00:01Z" (act agent apply_restock must_not)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (stock_units (int 4)) (restock_approved (bool false)))))
