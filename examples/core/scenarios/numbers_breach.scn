; The seller ships while the credit limit is unknown: the comparison is
; undefined, so there is no breach. The limit then arrives below the order
; amount, and the next shipment breaches the prohibition. The order amount
; reaches 1000.00, so the cancellation is permitted.
(scenario numbers_breach
  (spec "examples/core/core_numbers.triel")
  (entry "2026-05-01T00:00:00Z" (activate)
    (data (order (record (amount (dec 1200.50)) (quantity (int 3))))))
  (entry "2026-05-01T01:00:00Z" (act seller ship must_not)
    (data (order (record (amount (dec 1200.50)) (quantity (int 3))))))
  (entry "2026-05-01T02:00:00Z" (arrive credit_limit)
    (data (order (record (amount (dec 1200.50)) (quantity (int 3))))
          (credit_limit (dec 1000.00))))
  (entry "2026-05-01T03:00:00Z" (act seller ship must_not)
    (data (order (record (amount (dec 1200.50)) (quantity (int 3))))
          (credit_limit (dec 1000.00))))
  (entry "2026-05-01T04:00:00Z" (act buyer cancel may)
    (data (order (record (amount (dec 1200.50)) (quantity (int 3))))
          (credit_limit (dec 1000.00)))))
