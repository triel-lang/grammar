; There is no notification within 72 hours. On 30 May, 5 days after
; activation, the controller notifies the authority with the reasons for the
; delay. The fallback came into force at the first deadline, 28 May 10:00, and
; runs 7 days from it, until 4 June 10:00; the notification with reasons is
; inside that window, so the fallback is fulfilled and nothing is breached.
(scenario gdpr_reasons_after_5_days
  (spec "examples/core/gdpr_art33_notification.triel")
  (entry "2026-05-25T10:00:00Z" (activate)
    (data))
  (entry "2026-05-30T10:00:00Z" (act controller (notify_with_reasons (name authority)) must)
    (data (affected_records (int 1200)))))
