; The landlord issues the receipt on the second day and the tenant pays 1200 on
; 5 March: both obligations are fulfilled, and neither fallback comes into force.
(scenario fallback_on_time
  (spec "examples/core/core_fallback.triel")
  (entry "2026-03-01T00:00:00Z" (activate) (data (rent (dec 1200.00))))
  (entry "2026-03-02T00:00:00Z" (act landlord issue_receipt must) (data (rent (dec 1200.00))))
  (entry "2026-03-05T00:00:00Z" (act tenant (pay (name landlord) (int 1200)) must) (data (rent (dec 1200.00)))))
