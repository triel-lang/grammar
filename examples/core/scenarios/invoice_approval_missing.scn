; The invoice is quoted at 1500.00 EUR, over the limit, and nothing is known
; about the owner's approval: owner_approved is absent. The condition is
; undefined (true AND undefined). A monitor that enforces the rule blocks the
; payment, since the condition is not known to be false; the agent pays all
; the same, and the verdict records no breach, since the condition is not
; true (formal/core/CORE.md, undefined_guard_blocks_not_breach).
(scenario invoice_approval_missing
  (spec "examples/core/core_invoice_agent.triel")
  (entry "2026-11-02T09:00:00Z" (activate) (data (limit_eur (dec 1000.00))))
  (entry "2026-11-02T09:30:00Z" (arrive amount_eur)
    (data (amount_eur (dec 1500.00)) (limit_eur (dec 1000.00))))
  (entry "2026-11-02T10:00:00Z" (act agent (pay (name supplier)) must)
    (data (amount_eur (dec 1500.00)) (limit_eur (dec 1000.00)))))
