; The euro balance of 1200000, below its target of 3000000, arrives at
; 09:00:10 and a quote at 09:00:20; the request r1 is prepared at 09:00:30 and
; goes to the monitors at once. No daily limit is reported. It is a request of
; 800000 euros: the condition of the daily rule and that of the limits rule
; are undefined, so MONITOR 8 and MONITOR 12 block the request, and nothing is
; breached. The invariant is U.
(scenario treasury_limit_missing
  (spec "examples/core/treasury_mandate.triel")
  (entry "2026-11-20T09:00:00Z" (activate)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (approval_threshold (dec 1000000.00))))
  (entry "2026-11-20T09:00:10Z" (arrive eur_balance)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00))))
  (entry "2026-11-20T09:00:20Z" (arrive quote_rate)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450))))
  (entry "2026-11-20T09:00:30Z" (tick)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450)) (request_id (str "r1")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 800000.00)) (day_total_eur (dec 800000.00))))
  (entry "2026-11-20T09:00:30Z" (act agent request_conversion must_not)
    (data (mandate_active (bool true)) (window_open (bool true)) (eur_target (dec 3000000.00)) (trade_limit (dec 5000000.00)) (approval_threshold (dec 1000000.00)) (eur_balance (dec 1200000.00)) (quote_rate (dec 1.1450)) (request_id (str "r1")) (sell_currency (str "GBP")) (buy_currency (str "EUR")) (amount_eur (dec 800000.00)) (day_total_eur (dec 800000.00)))))
