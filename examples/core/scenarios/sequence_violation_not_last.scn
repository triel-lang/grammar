; Bob leaks after Alice pays, and the trace goes on. The whole trace is not a
; violated trace of "alice MUST pay THEN bob MUST_NOT leak", but its prefix up to
; the leak, entry 2, is, and no shorter prefix ends the observation: the status
; is VIOLATED at entry 2, and the tick does not change it (formal/core/CORE.md,
; decision 34).
(scenario sequence_violation_not_last
  (spec "examples/core/core_sequence.triel")
  (entry "2026-06-01T09:00:00Z" (activate)
    (data))
  (entry "2026-06-01T10:00:00Z" (act alice pay must)
    (data))
  (entry "2026-06-01T11:00:00Z" (act bob leak must_not)
    (data))
  (entry "2026-06-01T12:00:00Z" (tick)
    (data)))
