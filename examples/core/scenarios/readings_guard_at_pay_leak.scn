; As readings_guard_at_pay, then Bob leaks. In the second term the reading in
; which the guard interrupts the obligation has reached the handler
; bob MUST_NOT leak, and the leak violates it: the status is VIOLATED at
; entry 2, not DONE at entry 1. The other terms are violated at entry 2 too.
(scenario readings_guard_at_pay_leak
  (spec "examples/core/core_readings.triel")
  (entry "2026-06-01T00:00:00Z" (activate)
    (data (flag (bool false))))
  (entry "2026-06-01T01:00:00Z" (act alice pay must)
    (data (flag (bool true))))
  (entry "2026-06-01T02:00:00Z" (act bob leak must_not)
    (data (flag (bool true)))))
