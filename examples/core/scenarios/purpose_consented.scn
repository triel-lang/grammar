; The controller records the consent of the data subject to the new purpose at
; 09:05, and an assessment that the new purpose is not compatible at 09:10;
; the Annex 2 condition is not met. At 10:00 the agent transfers the data: in
; the state of 09:10 the consent is 55 minutes old, within MAX_AGE 30 DAYS, so
; the condition of the permission is true and the condition of the prohibition
; false. The permission is exercised, nothing is breached, and the monitor lets
; the transfer through. ALWAYS is never T on a finite prefix, so the invariant
; is U although no entry violates it.
(scenario purpose_consented
  (spec "examples/core/purpose_limitation_gate.triel")
  (entry "2026-11-02T09:00:00Z" (activate)
    (data (annex2_condition_met (bool false)) (data_transferred (bool false))))
  (entry "2026-11-02T09:05:00Z" (arrive new_purpose_consented)
    (data (new_purpose_consented (bool true)) (annex2_condition_met (bool false)) (data_transferred (bool false))))
  (entry "2026-11-02T09:10:00Z" (arrive assessed_compatible)
    (data (new_purpose_consented (bool true)) (annex2_condition_met (bool false)) (assessed_compatible (bool false))
          (data_transferred (bool false))))
  (entry "2026-11-02T10:00:00Z" (act agent transfer_personal_data may)
    (data (new_purpose_consented (bool true)) (annex2_condition_met (bool false)) (assessed_compatible (bool false))
          (data_transferred (bool true)))))
