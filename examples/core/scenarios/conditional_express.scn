; express is true when the conditional term is reached, so the IF takes its
; THEN branch, REF delivery: the trace ships and invoices, a run of delivery.
; discount is absent, so DEFAULT(discount, 0) is 0 and the WHEN condition is
; false: the WHEN term completes at once, and the trace of three entries is
; not one of its runs. cancelled is absent, so the UNLESS guard never fires.
(scenario conditional_express
  (spec "examples/core/core_conditional.triel")
  (entry "2026-06-01T00:00:00Z" (activate)
    (data (express (bool true)) (order (record (amount (dec 1200.00)))) (rush_fee (int 20))))
  (entry "2026-06-01T01:00:00Z" (act seller ship must)
    (data (express (bool true)) (order (record (amount (dec 1200.00)))) (rush_fee (int 20))))
  (entry "2026-06-01T02:00:00Z" (act seller invoice must)
    (data (express (bool true)) (order (record (amount (dec 1200.00)))) (rush_fee (int 20)))))
