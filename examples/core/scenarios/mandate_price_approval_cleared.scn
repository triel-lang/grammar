; The owner approves a change of 35 percent at 09:10:00, but the host clears
; the approval at 09:11:00, before the change is applied at 09:11:01. The
; condition is read in the state of 09:11:00, where the approval is absent, so
; it is undefined: the monitor blocks the change and nothing is breached. An
; approval counts only in the state just before the change.
(scenario mandate_price_approval_cleared
  (spec "examples/core/merchant_mandate.triel")
  (entry "2026-11-10T09:00:00Z" (activate)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10))))
  (entry "2026-11-10T09:10:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec 35.0)) (price_change_approved (bool true))))
  (entry "2026-11-10T09:11:00Z" (tick)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec 35.0))))
  (entry "2026-11-10T09:11:01Z" (act agent apply_price_change must_not)
    (data (budget_limit (dec 5000.00)) (reorder_point (int 10)) (price_delta_pct (dec 35.0)))))
