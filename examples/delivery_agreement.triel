-- TRIEL example: obligations, deadlines, breach handling
-- Demonstrates: FACTORS with SOURCE/MAX_AGE, ON_BREACH, SAFETY invariant

SPECIFICATION late_delivery_agreement VERSION 1.0.0
    STANDARD "INCOTERMS-2020"
    JURISDICTION "EU"
    PROVENANCE_REQUIRED: true
    CURRENCY: "USD"

SUBJECTS {
  seller  : PARTY,
  buyer   : PARTY,
  carrier : ORACLE
}

TERMS {
  seller MUST deliver_goods BY DATETIME("2026-08-01T00:00:00Z");
  seller ON_BREACH
    PENALTY order_value * 0.05 CAP 10000,
    NOTIFY buyer,
    CURE_BY 5 DAYS
}

FACTORS {
  shipment_status : String  METADATA SOURCE carrier MAX_AGE 1 HOURS ON_STALE BLOCK,
  delay_days      : Integer POLARITY 1.0 THRESHOLD 5.0 SOURCE carrier,
  order_value     : Decimal METADATA
}

INVARIANTS {
  delivery_within_cure_period : SAFETY : ALWAYS(delay_days <= 5)
}
