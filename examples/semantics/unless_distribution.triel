-- TRIEL example: distributing UNLESS over THEN
-- These two terms are equivalent:
--   (A THEN B) UNLESS c DO E
--   (A UNLESS c DO E) THEN (B UNLESS c DO E)
-- Both sides watch the guard at the same states, so it fires at the same
-- point, and an interrupted A ends Interrupted, so B does not start after
-- it (TECHNICAL_REPORT 2.5). If the guard were checked only once on entry,
-- they would differ: with c turning true during A, the first completes
-- A THEN B, while the second runs E instead of B.

SPECIFICATION sem_unless_distribution VERSION 1.0.0

SUBJECTS {
  seller : PARTY,
  buyer  : PARTY
}

TERMS {
  lhs := (seller MUST deliver THEN seller MUST invoice)
           UNLESS force_majeure DO seller MUST notify;
  rhs := (seller MUST deliver UNLESS force_majeure DO seller MUST notify)
           THEN (seller MUST invoice UNLESS force_majeure DO seller MUST notify)
}

FACTORS {
  force_majeure : Boolean METADATA
}

INVARIANTS {
  guard_observable : SAFETY : ALWAYS(PRESENT(force_majeure))
}
