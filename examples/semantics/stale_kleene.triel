-- TRIEL example: a guard over one fresh and one stale factor
-- Semantics question: with sanctioned = true and fresh, and claim stale
-- under ON_STALE BLOCK, is the guard blocked? Read as dependency-based
-- blocking, yes: the guard mentions claim. Read with strong Kleene
-- disjunction over the fresh data only, the guard is true, and no later
-- value of claim can change that verdict. The invariant below raises a
-- second question: PRESENT(claim.amount) must itself be exempt from
-- BLOCK, otherwise the guard written to handle staleness is blocked by it.

SPECIFICATION sem_stale_kleene VERSION 1.0.0
    PROVENANCE_REQUIRED: true

SUBJECTS {
  insurer  : PARTY,
  oracle_a : ORACLE,
  oracle_b : ORACLE
}

TERMS {
  WHEN sanctioned OR claim.amount > 1000000 THEN insurer MUST escalate_review
}

FACTORS {
  sanctioned : Boolean METADATA SOURCE oracle_a MAX_AGE 1 DAYS ON_STALE BLOCK,
  claim : Record { amount : Integer, claimant : String } METADATA SOURCE oracle_b MAX_AGE 1 HOURS ON_STALE BLOCK
}

INVARIANTS {
  claim_usable : SAFETY : ALWAYS(PRESENT(claim.amount) IMPLIES claim.amount >= 0)
}
