-- TRIEL example: a guard over one fresh and one stale factor
-- With sanctioned fresh and true and claim stale under ON_STALE BLOCK,
-- the guard is true: a stale factor is treated as absent and the
-- disjunction is evaluated in strong Kleene logic (TECHNICAL_REPORT 2.9).
-- No later value of claim can change this verdict. Had sanctioned been
-- false, the guard would be undefined and the term would wait, recording
-- that oracle_b's data is unavailable. The invariant relies on PRESENT
-- being exempt from BLOCK: PRESENT of a stale factor is false, so the
-- implication holds instead of being blocked.

SPECIFICATION sem_stale_kleene VERSION 1.0.0
    PROVENANCE_REQUIRED: true

SUBJECTS {
  insurer  : PARTY,
  oracle_a : ORACLE,
  oracle_b : ORACLE
}

TERMS {
  WHEN sanctioned OR claim.amount > 1000000 THEN insurer MUST escalate_review
}

FACTORS {
  sanctioned : Boolean METADATA SOURCE oracle_a MAX_AGE 1 DAYS ON_STALE BLOCK,
  claim : Record { amount : Integer, claimant : String } METADATA SOURCE oracle_b MAX_AGE 1 HOURS ON_STALE BLOCK
}

INVARIANTS {
  claim_usable : SAFETY : ALWAYS(PRESENT(claim.amount) IMPLIES claim.amount >= 0)
}
