-- TRIEL example: nested UNLESS with the same guard
-- The nested term is equivalent to the flat one. The outer guard watches
-- the same states as the inner one, so it becomes true at the same point
-- and E runs once (TECHNICAL_REPORT 2.5). That the outer interruption
-- takes priority follows from the definition; it is not a separate rule.
-- The names nested and flat label the two sides of the equation. A named
-- term is in force (TECHNICAL_REPORT 2.5), so read as a contract this file
-- puts both sides in force at once; it is meant only to illustrate the law.

SPECIFICATION sem_unless_nesting VERSION 1.0.0

SUBJECTS {
  seller : PARTY
}

TERMS {
  nested := (seller MUST deliver UNLESS force_majeure DO seller MUST notify)
              UNLESS force_majeure DO seller MUST notify;
  flat   := seller MUST deliver UNLESS force_majeure DO seller MUST notify
}

FACTORS {
  force_majeure : Boolean METADATA
}

INVARIANTS {
  guard_observable : SAFETY : ALWAYS(PRESENT(force_majeure))
}
